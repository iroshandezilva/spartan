{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spartant.dev/schema/spartant-tokens.schema.json",
  "title": "Spartant design token file",
  "description": "A token file in the W3C Design Tokens Community Group format, narrowed to the types and metadata Spartant uses. Structure only. Naming grammar, alias resolution, layer rules, and deprecation rules are enforced by scripts/check-tokens.mjs, because they are not expressible in JSON Schema.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$description": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/groupOrToken"
  },
  "$defs": {
    "type": {
      "enum": [
        "color",
        "dimension",
        "duration",
        "cubicBezier",
        "number",
        "fontFamily",
        "fontWeight",
        "shadow",
        "spring"
      ]
    },
    "alias": {
      "type": "string",
      "pattern": "^\\{[a-z0-9]+(?:[.-][a-z0-9]+)*\\}$",
      "description": "Reference to another token, for example {color.blue.500}."
    },
    "shadowValue": {
      "type": "object",
      "required": ["color", "offsetX", "offsetY", "blur", "spread"],
      "properties": {
        "color": {
          "type": "string"
        },
        "offsetX": {
          "type": "string"
        },
        "offsetY": {
          "type": "string"
        },
        "blur": {
          "type": "string"
        },
        "spread": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "required": ["$value"],
      "properties": {
        "$value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/shadowValue"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/shadowValue"
              }
            },
            {
              "$ref": "#/$defs/springValue"
            }
          ]
        },
        "$type": {
          "$ref": "#/$defs/type"
        },
        "$description": {
          "type": "string"
        },
        "$deprecated": {
          "type": "string",
          "description": "Present means deprecated. The string is the reason, shown to anyone who looks the token up."
        },
        "$extensions": {
          "type": "object",
          "properties": {
            "com.spartant": {
              "type": "object",
              "properties": {
                "replacedBy": {
                  "type": "string",
                  "description": "Token path that supersedes this one. Required when $deprecated is present."
                },
                "removeIn": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "description": "Version this token is removed in. Required when $deprecated is present."
                },
                "pairsWith": {
                  "type": "string",
                  "description": "Token this one is contrast-validated against. Consumed by HAUX-37."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "$type": {
          "$ref": "#/$defs/type"
        },
        "$description": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "$ref": "#/$defs/groupOrToken"
        }
      },
      "additionalProperties": false
    },
    "groupOrToken": {
      "oneOf": [
        {
          "$ref": "#/$defs/token"
        },
        {
          "$ref": "#/$defs/group"
        }
      ]
    },
    "springValue": {
      "type": "object",
      "required": ["stiffness", "damping", "mass"],
      "properties": {
        "stiffness": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "damping": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mass": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
