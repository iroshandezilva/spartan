{
  "name": "spartant-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4310",
    "build": "pnpm tokens:build && pnpm plugin:build && pnpm components:build && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 4310",
    "typecheck": "tsc --noEmit && tsc -p plugin/tsconfig.json && pnpm --filter @spartant-lab/components typecheck",
    "test": "pnpm components:build && node --import tsx --test tests/*.test.ts",
    "tokens:build": "pnpm tokens:import && node --import tsx scripts/build-tokens.ts",
    "plugin:build": "node scripts/build-plugin.mjs",
    "components:build": "pnpm --filter @spartant-lab/components build",
    "storybook": "pnpm --filter @spartant-lab/components storybook",
    "storybook:build": "pnpm --filter @spartant-lab/components build-storybook",
    "tokens:import": "node --import tsx scripts/import-figma-tokens.ts",
    "tokens:check": "node --import tsx scripts/check-tokens.ts",
    "test:e2e": "pnpm storybook:build && node --import tsx --test e2e/*.e2e.ts"
  },
  "dependencies": {
    "fumadocs-core": "^16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "^16.16.2",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.141.0",
    "@spartant-lab/components": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "playwright-core": "1.62.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
