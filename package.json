{
  "name": "spartant-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:color-tool": "pnpm --filter spartant-color-tool build",
    "build:docs": "pnpm build:package && pnpm --filter spartant-docs build",
    "build:example": "pnpm --filter spartant-example-consumer build",
    "build:foundations": "pnpm --filter spartant-foundations build",
    "build:package": "pnpm --filter @iroshandezilva/spartant build",
    "build:storybook": "pnpm build:package && pnpm --filter spartant-storybook build",
    "check": "biome check .",
    "check:colors": "pnpm tooling:build && node packages/spartant/tooling/.dist/tokens/check-colors.js",
    "check:docs": "node scripts/check-docs-links.mjs",
    "check:fix": "biome check --write .",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "clean": "tsc -b --clean && rm -rf .artifacts coverage",
    "dev": "pnpm --filter @iroshandezilva/spartant dev",
    "dev:color-tool": "pnpm build:package && pnpm --filter spartant-color-tool dev",
    "dev:docs": "pnpm build:package && pnpm --filter spartant-docs dev",
    "dev:example": "pnpm build:package && pnpm --filter spartant-example-consumer dev",
    "dev:foundations": "pnpm build:package && pnpm --filter spartant-foundations dev",
    "dev:storybook": "pnpm build:package && pnpm --filter spartant-storybook dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "inspect:package": "pnpm build:package && node scripts/inspect-package.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "preinstall": "node scripts/check-package-manager.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:note": "node scripts/release-note.mjs",
    "release:plan": "node scripts/release-prepare.mjs --dry-run",
    "release:prepare": "node scripts/release-prepare.mjs",
    "review:storybook": "node scripts/serve-static.mjs apps/storybook/storybook-static",
    "smoke:package": "pnpm build:package && node scripts/smoke-test.mjs",
    "test": "pnpm build:package && vitest run",
    "test:stories": "pnpm build:package && vitest run --config apps/storybook/vitest.config.ts",
    "test:watch": "pnpm build:package && vitest",
    "tokens:build": "pnpm tooling:build && node packages/spartant/tooling/.dist/tokens/generate.js",
    "tokens:check": "pnpm tooling:build && node packages/spartant/tooling/.dist/tokens/generate.js --check",
    "tooling:build": "tsc -p packages/spartant/tooling/tsconfig.json",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "validate": "pnpm format:check && pnpm lint && pnpm check:docs && pnpm check:tokens && pnpm tokens:check && pnpm check:colors && pnpm typecheck && pnpm test && pnpm test:stories && pnpm build && pnpm inspect:package"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
